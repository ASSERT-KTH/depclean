{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Automerge non-major updates after a 3-day cooldown (supply-chain safety)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Gradle 9 embeds Groovy 4; keep Spock on the -groovy-4.0 variant",
      "matchPackageNames": ["org.spockframework:spock-core"],
      "allowedVersions": "/-groovy-4\\.0$/"
    }
  ],
  "vulnerabilityAlerts": {
    "description": "Security fixes skip the cooldown and get merged immediately",
    "minimumReleaseAge": null,
    "prPriority": 10
  },
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "includeForks": true,
  "dependencyDashboard": true,
  "prConcurrentLimit": 5
}
